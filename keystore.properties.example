# Sao chép file này thành keystore.properties rồi điền thông tin thật.
# keystore.properties đã nằm trong .gitignore nên sẽ không bị commit.
#
# Tạo kho khoá mới bằng lệnh:
#   keytool -genkey -v -keystore charg-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias charg
#
# GIỮ KỸ file .jks và mật khẩu: mất nó là không cập nhật được app
# đã phát hành trên Google Play, buộc phải đăng một app mới hoàn toàn.

storeFile=charg-release.jks
storePassword=
keyAlias=charg
keyPassword=
