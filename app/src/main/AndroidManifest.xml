<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==== Quyền cơ bản ==== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Tắt/bật lại đồng bộ tự động khi vào chế độ sạc tối ưu (quyền mức normal) -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!--
      Xếp hạng ứng dụng theo thời gian dùng ở mục "Sử dụng pin ứng dụng".
      Quyền đặc biệt: khai báo ở đây không đủ, người dùng phải tự bật trong Cài đặt.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground service theo dõi phiên sạc liên tục -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 13+: bắt buộc xin runtime mới hiện được notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Đọc mức pin / nhiệt độ không cần quyền; chỉ khai báo feature tuỳ chọn -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:name=".ChargApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.ChargManagement"
        tools:targetApi="33">

        <!--
          Mã ứng dụng AdMob. Đây là mã THỬ NGHIỆM chính thức của Google.
          Thay bằng mã thật trong tài khoản AdMob trước khi phát hành,
          và thay luôn các mã đơn vị quảng cáo trong AdConfig.java.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".controller.vip.VipActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChargManagement.Splash"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".controller.home.HomeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.power.CheckPowerActivity"
            android:exported="false"
            android:parentActivityName=".controller.home.HomeActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.detail.PhoneDetailActivity"
            android:exported="false"
            android:parentActivityName=".controller.home.HomeActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.history.ChargeHistoryActivity"
            android:exported="false"
            android:parentActivityName=".controller.home.HomeActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.history.SessionDetailActivity"
            android:exported="false"
            android:parentActivityName=".controller.history.ChargeHistoryActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.alarm.ChargeAlarmActivity"
            android:exported="false"
            android:parentActivityName=".controller.home.HomeActivity"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.power.XChargeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!--
          Màn báo động: launchMode singleTask để cảnh báo mới cập nhật vào màn
          đang mở thay vì chồng thêm một màn nữa. excludeFromRecents vì đây là
          màn tạm, không nên nằm lại trong danh sách ứng dụng gần đây.
        -->
        <activity
            android:name=".controller.alarm.AlarmRingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ChargManagement.Alarm"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.tools.PhoneTemperatureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.tools.CpuUsageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.tools.NotificationCleanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".controller.settings.LanguageActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- Dịch vụ đọc/xoá thông báo; người dùng phải tự cấp quyền trong Cài đặt -->
        <service
            android:name=".service.NotificationCleanerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Dịch vụ nền duy nhất: ghi lại mức pin để dựng biểu đồ theo ngày, chạy cả
          khi người dùng đã thoát app. Không lấy mẫu định kỳ – chỉ nghe broadcast
          ACTION_BATTERY_CHANGED do hệ thống phát.
        -->
        <service
            android:name=".service.BatteryLogService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Ghi lại mức pin liên tục để dựng biểu đồ lịch sử pin theo ngày" />
        </service>

        <receiver
            android:name=".service.ChargingStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
