<?xml version="1.0" encoding="utf-8"?>
<!--
  Thẻ thống kê nhỏ: tiêu đề / giá trị lớn màu xanh / chú thích.
  Include 7 lần ở tab Sử dụng pin nên tách riêng để khỏi lặp XML.

  Chiều cao PHẢI là wrap_content. Trước đây để match_parent và cả thẻ co về
  chiều cao 0: LinearLayout ngang với chiều cao wrap_content lấy chiều cao từ
  các con, mà con lại đòi cao bằng cha – hai bên chờ nhau nên ra 0. Kết quả là
  hai mục "Sử dụng pin trung bình" và "Pin đã sạc" hiện ra trống trơn dù số liệu
  đã tính xong.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <!-- Ép hai dòng để các thẻ cùng hàng cao bằng nhau dù nhãn dài ngắn khác nhau -->
    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        tools:text="Sử dụng kết hợp" />

    <TextView
        android:id="@+id/tvCardValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/value_placeholder"
        android:textColor="@color/text_value"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="0,0 %/h" />

    <TextView
        android:id="@+id/tvCardDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        tools:text="0,0 % in 0,0 h" />

</LinearLayout>
