<?xml version="1.0" encoding="utf-8"?>
<!--
  Thẻ thống kê nhỏ: tiêu đề / giá trị lớn màu xanh / chú thích.
  Include 7 lần ở tab Sử dụng pin nên tách riêng để khỏi lặp XML.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        tools:text="Sử dụng kết hợp" />

    <TextView
        android:id="@+id/tvCardValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/value_placeholder"
        android:textColor="@color/green_accent"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="0,0 %/h" />

    <TextView
        android:id="@+id/tvCardDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        tools:text="0,0 % in 0,0 h" />

</LinearLayout>
