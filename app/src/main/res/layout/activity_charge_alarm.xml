<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbarInclude"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:id="@+id/tvPermissionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/state_warning"
                android:padding="@dimen/space_md"
                android:text="@string/alarm_permission_warning"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--
              Android 14+ chặn mở màn báo động đè lên màn khoá nếu chưa được cấp
              quyền toàn màn hình. Dải này bấm được, dẫn thẳng tới trang cấp quyền.
            -->
            <TextView
                android:id="@+id/tvFullScreenWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/state_warning"
                android:clickable="true"
                android:drawablePadding="@dimen/space_sm"
                android:focusable="true"
                android:padding="@dimen/space_md"
                android:text="@string/alarm_fullscreen_warning"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ===== Cảnh báo theo ngưỡng % ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/bg_surface"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alarm_threshold_setting" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/alarm_threshold_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchThreshold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/seekThreshold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="45"
                        tools:progress="30" />

                    <TextView
                        android:id="@+id/tvThresholdValue"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/text_value"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        tools:text="80%" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===== Cảnh báo sạc đầy ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/bg_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alarm_full_setting" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/alarm_full_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchFull"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <!-- ===== Cảnh báo quá nhiệt ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/bg_surface"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alarm_overheat_setting" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/alarm_overheat_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchOverheat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/seekOverheat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="17"
                        tools:progress="5" />

                    <TextView
                        android:id="@+id/tvOverheatValue"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/text_value"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold"
                        tools:text="43℃" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
