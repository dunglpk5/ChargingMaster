<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn sạc phủ toàn màn hình, hiện đè lên màn khoá khi cắm sạc.

  Không có nền riêng: hình nền của máy do hệ thống vẽ phía sau cửa sổ
  (windowShowWallpaper). Lớp phủ tối mỏng bên dưới chỉ để chữ trắng đọc được
  trên hình nền sáng – thiếu nó thì màn hình vô dụng với ai để hình nền sáng màu.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/charging_screen_scrim"
    android:fitsSystemWindows="true">

    <!-- ==================== Thanh trên cùng ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body"
            tools:text="13:46" />

        <ImageView
            android:id="@+id/btnOpenApp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/charging_screen_open_app"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_tab_home"
            app:tint="@color/text_on_primary" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_gear"
            app:tint="@color/text_on_primary" />

    </LinearLayout>

    <!-- ==================== Khối thông tin chính ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/charging_screen_top_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_battery_percent"
            tools:text="38%" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_title"
            tools:text="Đang sạc\n(2 h 19 m left)" />

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body"
            tools:text="Sạc AC, 39.0 ℃" />

        <!-- Ba giai đoạn sạc, ngăn cách bằng mũi tên -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/stageFast"
                layout="@layout/view_charge_stage" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_marginEnd="@dimen/space_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/stage_inactive" />

            <include
                android:id="@+id/stageCycle"
                layout="@layout/view_charge_stage" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_marginEnd="@dimen/space_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/stage_inactive" />

            <include
                android:id="@+id/stageTrickle"
                layout="@layout/view_charge_stage" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnDetectSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_charging_screen_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/charging_screen_detect"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body" />

        <!-- Cảnh báo sạc bất thường, cùng nguồn dữ liệu với màn X-Sạc -->
        <LinearLayout
            android:id="@+id/warningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_horizontal"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- Tia sét lớn ở giữa dưới, chỉ là trang trí -->
    <ImageView
        android:id="@+id/ivBolt"
        android:layout_width="@dimen/charging_screen_bolt_size"
        android:layout_height="@dimen/charging_screen_bolt_size"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/charging_screen_bolt_margin"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_voltage"
        app:tint="@color/text_on_primary" />

    <TextView
        android:id="@+id/tvSwipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/space_xl"
        android:gravity="center"
        android:text="@string/charging_screen_swipe"
        android:textColor="@color/text_on_primary"
        android:textSize="@dimen/text_body" />

</FrameLayout>
