<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbarInclude"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Nhóm chung ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/bg_surface"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/info_row_height"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_md"
                    android:paddingEnd="@dimen/space_md">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/language_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvLanguageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_value"
                        android:textSize="@dimen/text_body"
                        tools:text="Tiếng Việt" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_md"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/rowAlarm"
                    style="@style/SettingsRow"
                    android:text="@string/tools_charge_alarm" />

            </LinearLayout>

            <!-- ===== Nhóm dọn dẹp ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/bg_surface"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rowNotificationAccess"
                    style="@style/SettingsRow"
                    android:text="@string/settings_notification_access" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/space_md"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/rowClearClipboard"
                    style="@style/SettingsRow"
                    android:text="@string/tools_clean_clipboard" />

            </LinearLayout>

            <!-- ===== Nhóm thông tin ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@color/bg_surface"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rowAppInfo"
                    style="@style/SettingsRow"
                    android:text="@string/settings_app_info" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/space_lg"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="Phiên bản 1.0.0" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
