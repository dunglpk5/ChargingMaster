<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn Phát hiện sạc:
  1. Vòng cung nét đứt + tên tốc độ + dòng vào / dòng chờ + 2 nút
  2. Danh sách hạng mục phát hiện (thẻ khiên + nút viền cam)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbarInclude"
        layout="@layout/view_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== ĐỒNG HỒ CUNG ==================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/teal_primary"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_md">

                <com.dung.chargmagagement.controller.widget.ArcGaugeView
                    android:id="@+id/arcGauge"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Cụm chữ đặt đè lên giữa cung -->
                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_primary"
                    android:textSize="34sp"
                    app:layout_constraintBottom_toBottomOf="@id/arcGauge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/arcGauge"
                    app:layout_constraintVertical_bias="0.62"
                    tools:text="Rất chậm" />

                <TextView
                    android:id="@+id/tvCurrentIn"
                    style="@style/Text.HeaderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/arcGauge"
                    tools:text="Dòng vào: 276 mA" />

                <TextView
                    android:id="@+id/tvCurrentIdle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textColor="@color/state_warning"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCurrentIn"
                    tools:text="Dòng chờ: -251 mA" />

                <TextView
                    android:id="@+id/btnCheckSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_md"
                    android:paddingBottom="@dimen/space_md"
                    android:text="@string/check_power_source"
                    android:textColor="@color/text_on_primary"
                    app:layout_constraintEnd_toStartOf="@id/btnXCharge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCurrentIdle" />

                <TextView
                    android:id="@+id/btnXCharge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/bg_header_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_md"
                    android:paddingBottom="@dimen/space_md"
                    android:text="@string/check_x_charge"
                    android:textColor="@color/text_on_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btnCheckSource"
                    app:layout_constraintTop_toTopOf="@id/btnCheckSource" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ==================== DANH SÁCH HẠNG MỤC ==================== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="6"
                tools:listitem="@layout/item_drain_feature" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
