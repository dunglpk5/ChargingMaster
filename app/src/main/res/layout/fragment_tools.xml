<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab Công cụ:
  - Thanh tiêu đề mỏng nổi trên nền bg_app, giống Trang chủ
  - Ba thẻ chỉ số: Bộ nhớ / RAM / Pin, mỗi thẻ một vòng tiến trình và một nút
  - Ba nhóm công cụ dạng lưới 3 cột: Phát hiện, VIP, Công cụ
  - Nhóm "Khác": các dòng danh sách có mũi tên
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="@dimen/toolbar_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- ==================== BA THẺ CHỈ SỐ ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardStorage"
                    layout="@layout/view_stat_ring_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="@dimen/space_sm"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/cardRam"
                    layout="@layout/view_stat_ring_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="@dimen/space_sm"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/cardBattery"
                    layout="@layout/view_stat_ring_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

            </LinearLayout>

            <!-- ==================== NHÓM VIP ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_md">

                <TextView
                    style="@style/ToolGroupTitle"
                    android:text="@string/tools_group_vip" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVipTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:spanCount="3"
                    tools:itemCount="6"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_tool" />

            </LinearLayout>

            <!-- ==================== NHÓM PHÁT HIỆN ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_md">

                <TextView
                    style="@style/ToolGroupTitle"
                    android:text="@string/tools_group_detect" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDetectTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:spanCount="3"
                    tools:itemCount="6"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_tool" />

            </LinearLayout>

            <!-- ==================== NHÓM CÔNG CỤ ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_md">

                <TextView
                    style="@style/ToolGroupTitle"
                    android:text="@string/tools_group_general" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGeneralTools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:spanCount="3"
                    tools:itemCount="3"
                    tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    tools:listitem="@layout/item_tool" />

            </LinearLayout>

            <!-- ==================== NHÓM KHÁC ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_group_other"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <include
                    android:id="@+id/rowSettings"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/rowFeedback"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/rowPrivacyPolicy"
                    layout="@layout/item_menu_row" />

                <include
                    android:id="@+id/rowAboutUs"
                    layout="@layout/item_menu_row" />

            </LinearLayout>

            <!-- Quảng cáo native, ẩn khi người dùng đã mua VIP -->
            <FrameLayout
                android:id="@+id/adContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_rounded"
                android:minHeight="60dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                tools:text="Phiên bản 1.0.0" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Thanh tiêu đề mỏng, nổi đè lên nội dung; xem ghi chú ở fragment_dashboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/teal_primary"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRemoveAds"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_outline_white"
            android:clickable="true"
            android:contentDescription="@string/cd_remove_ads"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/home_ad_badge"
            android:textColor="@color/text_on_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/space_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_menu"
            android:padding="@dimen/space_xs"
            android:src="@drawable/ic_more"
            app:tint="@color/text_on_primary" />

    </LinearLayout>

</FrameLayout>
