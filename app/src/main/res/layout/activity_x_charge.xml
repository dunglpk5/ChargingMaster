<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn sạc tối ưu (X-Sạc): theo dõi phiên sạc theo thời gian thực.
  Nền teal toàn màn, số liệu cỡ lớn để nhìn được từ xa khi máy đang cắm sạc.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal_primary"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbarInclude"
        layout="@layout/view_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- Mức pin -->
            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_placeholder"
                android:textColor="@color/text_on_primary"
                android:textSize="72sp"
                android:textStyle="bold"
                tools:text="68%" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Text.HeaderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                tools:text="Đang sạc nhanh" />

            <!-- Thanh tiến trình mức pin -->
            <ProgressBar
                android:id="@+id/progressBattery"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_lg"
                android:max="100"
                android:progressTint="@color/green_accent"
                tools:progress="68" />

            <!-- Thời gian còn lại -->
            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:textColor="@color/text_on_primary"
                android:textSize="20sp"
                tools:text="Còn khoảng 1h 20m là đầy" />

            <!-- Lưới 4 chỉ số -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardCurrent"
                    layout="@layout/view_stat_column" />

                <include
                    android:id="@+id/cardVoltage"
                    layout="@layout/view_stat_column" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardTemperature"
                    layout="@layout/view_stat_column" />

                <include
                    android:id="@+id/cardElapsed"
                    layout="@layout/view_stat_column" />

            </LinearLayout>

            <!-- Cảnh báo bất thường, chỉ hiện khi có vấn đề -->
            <TextView
                android:id="@+id/tvWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card_white"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:textColor="@color/state_danger"
                android:textSize="@dimen/text_body"
                android:visibility="gone"
                tools:text="Pin đang nóng bất thường"
                tools:visibility="visible" />

            <!-- Danh sách tối ưu đã áp dụng và những mục cần tắt thủ công -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xcharge_optimizing"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <!-- Các dòng trạng thái được thêm bằng code vì số lượng thay đổi -->
                <LinearLayout
                    android:id="@+id/optimizeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btnGrantBrightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_detect_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/xcharge_grant_brightness"
                    android:textColor="@color/detect_button_border"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/btnManualOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_detect_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"
                    android:text="@string/xcharge_manual_off"
                    android:textColor="@color/detect_button_border"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:lineSpacingExtra="4dp"
                android:text="@string/xcharge_actions"
                android:textColor="@color/text_on_primary_60"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
