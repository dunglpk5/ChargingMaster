<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn sạc tối ưu (X-Sạc).

  Nền teal kín màn, không có thanh công cụ: đây là màn toàn cảnh để nhìn từ xa khi
  máy đang cắm sạc, nên mọi thứ đều cỡ lớn và căn giữa. Thoát bằng nút riêng ở dưới.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal_primary"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/text_on_primary"
            android:textSize="24sp" />

        <!-- Tên tốc độ sạc, đổi màu theo mức độ -->
        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:textColor="@color/green_accent"
            android:textSize="26sp"
            tools:text="Sạc nhanh" />

        <!-- Dòng nạp và nhiệt độ, đặt cạnh nhau như một dòng phụ đề -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_current"
                app:tint="@color/text_on_primary" />

            <TextView
                android:id="@+id/tvCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textColor="@color/text_on_primary"
                android:textSize="20sp"
                tools:text="1023 mA" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/space_lg"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_voltage"
                app:tint="@color/text_on_primary" />

            <TextView
                android:id="@+id/tvTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textColor="@color/text_on_primary"
                android:textSize="20sp"
                tools:text="36℃/ 96℉" />

        </LinearLayout>

        <!-- Vòng tròn chất lỏng, mức pin nằm đè lên giữa -->
        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="@dimen/space_xl">

            <com.dung.chargmagagement.controller.widget.LiquidBatteryView
                android:id="@+id/liquidBattery"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_on_primary"
                android:textSize="64sp"
                tools:text="42%" />

        </FrameLayout>

        <!-- Ba giai đoạn sạc, giai đoạn đang diễn ra được làm nổi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/stageFast"
                layout="@layout/view_charge_stage" />

            <ImageView
                android:id="@+id/imgArrowOne"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/stage_inactive" />

            <include
                android:id="@+id/stageCycle"
                layout="@layout/view_charge_stage" />

            <ImageView
                android:id="@+id/imgArrowTwo"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_md"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/stage_inactive" />

            <include
                android:id="@+id/stageTrickle"
                layout="@layout/view_charge_stage" />

        </LinearLayout>

        <!-- Danh sách bất thường, dựng bằng code vì số dòng thay đổi liên tục -->
        <LinearLayout
            android:id="@+id/warningContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical" />

        <!-- Số mục còn tiêu điện, bấm vào mở màn Phát hiện sạc để tắt từng mục -->
        <LinearLayout
            android:id="@+id/chipDrain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_chip_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_battery_level"
                app:tint="@color/shield_blue" />

            <TextView
                android:id="@+id/tvDrainCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:textColor="@color/text_on_primary"
                android:textSize="18sp"
                tools:text="3" />

        </LinearLayout>

        <!-- Nút xin quyền hạ độ sáng, chỉ hiện khi chưa được cấp -->
        <TextView
            android:id="@+id/btnGrantBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_detect_outline"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/xcharge_grant_brightness"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_dialog_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_md"
            android:text="@string/xcharge_exit"
            android:textAllCaps="true"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textColor="@color/text_on_primary"
            android:textSize="20sp"
            tools:text="1 h 9 m left" />

    </LinearLayout>

</ScrollView>
