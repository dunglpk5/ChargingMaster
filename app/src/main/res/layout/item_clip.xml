<?xml version="1.0" encoding="utf-8"?>
<!-- Một mục trong bộ nhớ tạm: nhãn + thời điểm ở trên, nội dung ở dưới -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvClipLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_value"
            android:textSize="@dimen/text_body"
            tools:text="Văn bản đã sao chép" />

        <TextView
            android:id="@+id/tvClipTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="14:16 Hôm nay" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvClipText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        tools:text="https://example.com/mot-duong-dan-rat-dai-vua-duoc-sao-chep" />

</LinearLayout>
