<?xml version="1.0" encoding="utf-8"?>
<!-- Một nhân CPU: biểu đồ nhỏ + ô màu và nhãn "CPU Core N" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_sm"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <com.dung.chargmagagement.controller.widget.MiniCpuChartView
        android:id="@+id/chartCore"
        android:layout_width="match_parent"
        android:layout_height="120dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginStart="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/cpu_chart_line" />

        <TextView
            android:id="@+id/tvCoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            tools:text="CPU Core 0" />

    </LinearLayout>

</LinearLayout>
