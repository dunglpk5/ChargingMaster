<?xml version="1.0" encoding="utf-8"?>
<!-- Một ô "CPU n — xung nhịp hiện tại" trong thẻ Tốc độ hiện tại -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/tvClockLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        tools:text="CPU 1" />

    <TextView
        android:id="@+id/tvClockValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="@color/text_value"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        tools:text="2 GHz" />

</LinearLayout>
