<?xml version="1.0" encoding="utf-8"?>
<!--
  Thẻ một hạng mục phát hiện:
  khiên màu + chấm than đỏ | tiêu đề + mô tả | nút viền cam "Phát hiện"
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_md"
    android:layout_marginTop="@dimen/space_sm"
    android:layout_marginEnd="@dimen/space_md"
    android:background="@drawable/bg_card_rounded"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <!-- Khiên nền, đổi màu theo mức độ ưu tiên của hạng mục -->
    <ImageView
        android:id="@+id/imgShield"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_shield"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/shield_orange" />

    <!--
      Icon riêng của từng hạng mục, đặt chồng lên khiên.

      Khiên thon dần rồi nhọn ở đáy, nên vùng chứa được icon hẹp hơn nhiều so với
      khung 44dp của nó. Căn giữa theo khung khiến icon rơi xuống đúng chỗ khiên
      bắt đầu bo vào, và bốn góc icon thò ra ngoài mép.

      Vì vậy icon nhỏ lại còn 16dp và được kéo lên trên bằng vertical_bias 0.42 –
      đặt tâm icon vào giữa phần thân rộng của khiên thay vì giữa hình chữ nhật.
    -->
    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/imgShield"
        app:layout_constraintEnd_toEndOf="@id/imgShield"
        app:layout_constraintStart_toStartOf="@id/imgShield"
        app:layout_constraintTop_toTopOf="@id/imgShield"
        app:layout_constraintVertical_bias="0.42"
        app:tint="@color/bg_surface"
        tools:src="@drawable/ic_feature_wifi" />

    <!--
      Chấm than báo hạng mục đang cần xử lý.

      Ràng buộc cũ đặt nó ở NGOÀI khiên: End_toStartOf + Top_toBottomOf đẩy chấm
      xuống dưới và sang trái khỏi khiên, tức vượt qua paddingStart của thẻ, nên
      hệ thống cắt mất một nửa ở mép trái. Nay neo vào góc dưới-trái của chính
      khiên để chấm luôn nằm trọn trong vùng vẽ được.
    -->
    <ImageView
        android:id="@+id/imgBadge"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_badge_warning"
        app:layout_constraintBottom_toBottomOf="@id/imgShield"
        app:layout_constraintStart_toStartOf="@id/imgShield" />

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@id/btnTurnOff"
        app:layout_constraintStart_toEndOf="@id/imgShield"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Phát hiện Bluetooth" />

    <TextView
        android:id="@+id/tvDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        app:layout_constraintEnd_toEndOf="@id/tvLabel"
        app:layout_constraintStart_toStartOf="@id/tvLabel"
        app:layout_constraintTop_toBottomOf="@id/tvLabel"
        tools:text="Tắt Bluetooth để giảm tiêu thụ điện năng" />

    <!--
      Dấu tích thay chỗ nút "Phát hiện" ở hạng mục đã đạt.

      Neo vào chính khung của nút chứ không vào mép thẻ: nút được ẩn bằng INVISIBLE
      nên khung của nó vẫn còn, dấu tích rơi đúng vào giữa chỗ nút từng nằm. Ẩn bằng
      GONE thì ràng buộc End_toStartOf của phần chữ sẽ co về một điểm và cả dòng
      chữ giãn ra, làm các thẻ trong danh sách so le nhau.
    -->
    <ImageView
        android:id="@+id/imgOk"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btnTurnOff"
        app:layout_constraintEnd_toEndOf="@id/btnTurnOff"
        app:layout_constraintStart_toStartOf="@id/btnTurnOff"
        app:layout_constraintTop_toTopOf="@id/btnTurnOff"
        app:tint="@color/shield_blue"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btnTurnOff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_detect_outline"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="96dp"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm"
        android:text="@string/check_turn_off"
        android:textAlignment="center"
        android:textColor="@color/detect_button_border"
        android:textSize="@dimen/text_body"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
