<?xml version="1.0" encoding="utf-8"?>
<!--
  Một dòng nhóm rác: biểu tượng, tên nhóm, dung lượng và ô tick.
  Cả dòng bấm được để đổi trạng thái tick, vùng chạm rộng hơn hẳn ô vuông nhỏ.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/info_row_height"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <ImageView
        android:id="@+id/ivGroupIcon"
        android:layout_width="@dimen/info_icon_size"
        android:layout_height="@dimen/info_icon_size"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_junk_cache" />

    <TextView
        android:id="@+id/tvGroupLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        tools:text="Bộ đệm rác" />

    <TextView
        android:id="@+id/tvGroupSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:textColor="@color/text_value"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        tools:text="6.77 MB" />

    <CheckBox
        android:id="@+id/cbGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:clickable="false"
        android:contentDescription="@string/clean_select_group"
        android:focusable="false" />

</LinearLayout>
