<?xml version="1.0" encoding="utf-8"?>
<!--
  Màn Giám sát pin, mở từ nút "Giám sát" ở thẻ Pin trong tab Công cụ:
  1. Biểu đồ mức pin 3 ngày gần đây, vuốt ngang để đổi ngày
  2. Thông tin lần sạc cuối
  3. Tình trạng pin (dung lượng ước tính vs thiết kế)
  4. Sử dụng pin trung bình (4 thẻ)
  5. Ước tính thời gian pin đầy (3 cột)
  6. Pin đã sạc (2 thẻ)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="@dimen/toolbar_height">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_lg">

            <!-- ==================== 1. BIỂU ĐỒ 3 NGÀY ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monitor_recent_days"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/chartPager"
                    android:layout_width="match_parent"
                    android:layout_height="248dp"
                    android:layout_marginTop="@dimen/space_sm" />

                <!-- Ba chấm chỉ trang, dựng bằng code để khỏi lặp XML -->
                <LinearLayout
                    android:id="@+id/pageDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:orientation="horizontal" />

            </LinearLayout>

            <!-- ==================== 2. LẦN SẠC CUỐI ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monitor_last_charge"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/rowLastSpeed"
                    layout="@layout/view_device_info_row" />

                <include
                    android:id="@+id/rowLastSource"
                    layout="@layout/view_device_info_row" />

                <include
                    android:id="@+id/rowLastDuration"
                    layout="@layout/view_device_info_row" />

                <include
                    android:id="@+id/rowLastQuality"
                    layout="@layout/view_device_info_row" />

                <include
                    android:id="@+id/rowSinceFull"
                    layout="@layout/view_device_info_row" />

            </LinearLayout>

            <!-- ==================== 3. TÌNH TRẠNG PIN ==================== -->
            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/usage_battery_health" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="2dp"
                android:text="@string/usage_health_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/usage_battery_health"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvHealthState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body"
                        tools:text="95 %" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressHealth"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_progress_track"
                    tools:progress="95" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/usage_estimated_capacity"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvEstimatedCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body"
                        tools:text="5700 mAh" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/usage_design_capacity"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:id="@+id/tvDesignCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/value_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body"
                        tools:text="6000 mAh" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvHealthBasis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    tools:text="Dựa trên 23 phiên…" />

                <TextView
                    android:id="@+id/btnSetDesignCapacity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/space_sm"
                    android:text="@string/usage_set_design_capacity"
                    android:textColor="@color/teal_primary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ==================== 4. SỬ DỤNG PIN TRUNG BÌNH ==================== -->
            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/usage_average" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardCombined"
                    layout="@layout/view_stat_card" />

                <Space
                    android:layout_width="@dimen/space_sm"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/cardSessions"
                    layout="@layout/view_stat_card" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardScreenOn"
                    layout="@layout/view_stat_card" />

                <Space
                    android:layout_width="@dimen/space_sm"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/cardScreenOff"
                    layout="@layout/view_stat_card" />

            </LinearLayout>

            <!-- ==================== 5. ƯỚC TÍNH PIN ĐẦY ==================== -->
            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/usage_full_estimate" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="2dp"
                android:text="@string/usage_full_estimate_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <include
                android:id="@+id/cardFullEstimate"
                layout="@layout/view_estimate_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <!-- ==================== 6. PIN ĐÃ SẠC ==================== -->
            <TextView
                style="@style/Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/usage_charged" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/cardChargeCount"
                    layout="@layout/view_stat_card" />

                <Space
                    android:layout_width="@dimen/space_sm"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/cardChargeAverage"
                    layout="@layout/view_stat_card" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Thanh tiêu đề mỏng, nổi đè lên nội dung -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/teal_primary"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_back"
            app:tint="@color/text_on_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/monitor_title"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
