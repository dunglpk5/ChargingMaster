<?xml version="1.0" encoding="utf-8"?>
<!--
  Một trong ba thẻ chỉ số ở đầu tab Công cụ: vòng tiến trình có % ở giữa, tên chỉ
  số, dòng chi tiết và một nút hành động. Dùng lại ba lần nên tách ra layout riêng.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:elevation="@dimen/card_elevation"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_sm"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/space_sm"
    android:paddingBottom="@dimen/space_md">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <com.dung.chargmagagement.controller.widget.RingProgressView
            android:id="@+id/ringProgress"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvRingPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="88%"
            tools:textColor="@color/stat_storage" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvRingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        tools:text="Bộ nhớ" />

    <TextView
        android:id="@+id/tvRingDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/value_placeholder"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        tools:text="96.7/109.5GB" />

    <TextView
        android:id="@+id/btnRingAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_sm"
        android:textColor="@color/text_on_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        tools:background="@drawable/bg_pill_primary"
        tools:text="Quét" />

</LinearLayout>
