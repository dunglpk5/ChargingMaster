<?xml version="1.0" encoding="utf-8"?>
<!--
  Một cột chỉ số ở header tab Công cụ: icon / số lớn / chú thích nhỏ.
  Tách ra để include 3 lần, tránh lặp 3 khối XML gần như giống hệt nhau.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgStatIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:tint="@color/text_on_primary"
        tools:ignore="UseAppTint"
        tools:src="@drawable/ic_stat_storage" />

    <TextView
        android:id="@+id/tvStatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/value_placeholder"
        android:textColor="@color/text_on_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        tools:text="88%" />

    <TextView
        android:id="@+id/tvStatDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_on_primary_60"
        android:textSize="@dimen/text_caption"
        tools:text="96.7GB/109.5GB" />

</LinearLayout>
