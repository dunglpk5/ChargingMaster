    <string name="settings_title">Configurações</string>
    <string name="settings_version">Versão %1$s</string>
    <string name="settings_battery_logging">Registrar histórico da bateria</string>
    <string name="settings_battery_logging_desc">Cada item abaixo precisa de um serviço em segundo plano enquanto o app está fechado. O serviço não consulta a bateria periodicamente, então o custo é insignificante, e ele para assim que as três chaves ficam desligadas. O alarme de carga, a contagem de cargas e a saúde da bateria funcionam sem nada disso.</string>
    <string name="alarm_exact_warning">Os alertas podem atrasar até você abrir o app. Toque aqui para permitir alarmes exatos e que eles toquem na hora.</string>
    <string name="settings_log_chart">Gráfico do nível da bateria</string>
    <string name="settings_log_chart_desc">Registra o nível da bateria o dia todo para que o gráfico de 00:00 a 24:00 fique contínuo.</string>
    <string name="settings_log_screen">Estatísticas de tela</string>
    <string name="settings_log_screen_desc">Separa o consumo pelo estado da tela, para os números de %/h e a estimativa de autonomia.</string>
