    <string name="settings_title">Ajustes</string>
    <string name="settings_version">Versión %1$s</string>
    <string name="settings_battery_logging">Registrar el historial de batería</string>
    <string name="settings_battery_logging_desc">Cada apartado de abajo necesita un servicio en segundo plano mientras la app está cerrada. El servicio no consulta la batería de forma periódica, así que el coste es insignificante, y se detiene en cuanto los tres interruptores están apagados. La alarma de carga, el recuento de cargas y la salud de la batería funcionan sin nada de esto.</string>
    <string name="alarm_exact_warning">Las alertas pueden retrasarse hasta que abras la app. Toca aquí para permitir alarmas exactas y que suenen a tiempo.</string>
    <string name="settings_log_chart">Gráfico del nivel de batería</string>
    <string name="settings_log_chart_desc">Registra el nivel de batería todo el día para que el gráfico de 00:00 a 24:00 sea continuo.</string>
    <string name="settings_log_screen">Estadísticas de pantalla</string>
    <string name="settings_log_screen_desc">Separa el consumo según el estado de la pantalla, para las cifras de %/h y la estimación de autonomía.</string>
    <string name="settings_log_details">Datos en vivo en la notificación</string>
    <string name="settings_log_details_desc">Muestra la corriente actual, la corriente media y el tiempo de pantalla en la notificación permanente. Al apagarlo solo queda el nivel de batería.</string>
